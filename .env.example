# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ridehailing?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Backend API
BACKEND_URL="http://localhost:4000"
BACKEND_PORT=4000
JWT_SECRET="your-jwt-secret-here-change-in-production"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# Maps (Choose one)
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token-here"
NEXT_PUBLIC_GOOGLE_MAPS_KEY="your-google-maps-key-here"

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# Redis (for WebSocket scaling)
REDIS_URL="redis://localhost:6379"

# Email (optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Admin credentials (first time setup)
ADMIN_EMAIL="admin@ridehailing.com"
ADMIN_PASSWORD="change-this-password"

# Application
NODE_ENV="development"
