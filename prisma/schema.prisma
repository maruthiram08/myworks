// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth.js models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isAdmin       Boolean   @default(false)

  // Gamification fields
  xp            Int       @default(0)
  level         Int       @default(1)
  hearts        Int       @default(5)
  gems          Int       @default(0)
  timezone      String    @default("UTC")

  // Preferences
  soundEnabled  Boolean   @default(true)
  notificationsEnabled Boolean @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      UserProgress[]
  answers       UserAnswer[]
  streaks       Streak[]
  quests        UserQuest[]
  achievements  UserAchievement[]

  @@index([email])
  @@index([xp])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Learning content models
model Language {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique // e.g., "en", "es", "fr"
  flag        String   // emoji or URL
  description String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       Unit[]

  @@index([code])
  @@index([isActive])
}

model Unit {
  id          String   @id @default(cuid())
  languageId  String
  title       String
  description String?
  order       Int
  color       String   @default("#22c55e") // Hex color for UI
  isLocked    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  language    Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([languageId, order])
  @@index([languageId])
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String
  title       String
  description String?
  order       Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  challenges  Challenge[]
  progress    UserProgress[]

  @@unique([unitId, order])
  @@index([unitId])
}

model Challenge {
  id          String   @id @default(cuid())
  lessonId    String
  order       Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   Question[]
  answers     UserAnswer[]

  @@unique([lessonId, order])
  @@index([lessonId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT_INPUT
  AUDIO
  IMAGE_SELECT
  MATCH_PAIRS
  FILL_BLANK
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Question {
  id          String         @id @default(cuid())
  challengeId String
  type        QuestionType
  difficulty  DifficultyLevel @default(BEGINNER)
  order       Int

  // Question content
  prompt      String         @db.Text
  audioUrl    String?        // For audio questions or audio prompts
  imageUrl    String?        // For image-based questions

  // Answer options (JSON for flexibility)
  // For MULTIPLE_CHOICE: ["option1", "option2", "option3", "option4"]
  // For MATCH_PAIRS: [{"left": "word", "right": "definition"}]
  // For IMAGE_SELECT: [{"imageUrl": "...", "text": "..."}]
  options     Json?

  // Correct answer(s)
  correctAnswer String       @db.Text

  // Alternative accepted answers (JSON array)
  alternativeAnswers Json?

  // Hints and explanations
  hint        String?        @db.Text
  explanation String?        @db.Text

  // Points awarded
  points      Int            @default(10)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  challenge   Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  answers     UserAnswer[]

  @@unique([challengeId, order])
  @@index([challengeId])
  @@index([type])
  @@index([difficulty])
}

// User progress tracking
model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String

  completed   Boolean  @default(false)
  score       Int      @default(0)
  accuracy    Float    @default(0) // Percentage
  attempts    Int      @default(0)

  // Spaced repetition
  lastReviewed DateTime?
  nextReview  DateTime?
  easeFactor  Float    @default(2.5) // SM-2 algorithm
  interval    Int      @default(1)   // Days until next review
  repetitions Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([nextReview])
}

model UserAnswer {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  questionId  String

  answer      String   @db.Text
  isCorrect   Boolean
  timeSpent   Int      // Seconds
  hintsUsed   Int      @default(0)

  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId])
  @@index([questionId])
  @@index([createdAt])
}

// Streak tracking
model Streak {
  id          String   @id @default(cuid())
  userId      String

  currentStreak Int    @default(0)
  longestStreak Int    @default(0)
  lastActivity  DateTime @default(now())
  frozenDays    Int    @default(0) // Streak freeze items used

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@index([lastActivity])
}

// Daily quests
enum QuestType {
  COMPLETE_LESSONS
  EARN_XP
  PERFECT_SCORE
  USE_APP_STREAK
  REVIEW_LESSONS
}

model Quest {
  id          String   @id @default(cuid())
  type        QuestType
  title       String
  description String

  target      Int      // e.g., "Complete 5 lessons", target = 5
  xpReward    Int
  gemsReward  Int      @default(0)

  // Quest validity
  isDaily     Boolean  @default(true)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userQuests  UserQuest[]

  @@index([type])
  @@index([isDaily])
  @@index([isActive])
}

model UserQuest {
  id          String   @id @default(cuid())
  userId      String
  questId     String

  progress    Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)

  // Reset tracking for daily quests
  assignedDate DateTime @default(now())
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, assignedDate])
  @@index([userId])
  @@index([questId])
  @@index([assignedDate])
}

// Achievements
enum AchievementCategory {
  LESSONS
  STREAKS
  XP
  PERFECT_SCORES
  SPEED
  SOCIAL
}

model Achievement {
  id          String              @id @default(cuid())
  category    AchievementCategory
  title       String
  description String
  icon        String              // emoji or icon name

  requirement Int                 // Threshold to unlock
  xpReward    Int

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  userAchievements UserAchievement[]

  @@index([category])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String

  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}
